# Copy to .env and choose your own values. Never commit the completed .env.
# Required for first startup; at least 10 characters, preferably a random password.
FTW_ADMIN_PASSWORD=
FTW_STORAGE=json
FTW_DATA_DIR=./data
PORT=4173
# Docker listens on localhost unless deliberately changed.
FTW_BIND_ADDRESS=127.0.0.1
# Optional incoming-message connectors must share a long random webhook secret.
FTW_WEBHOOK_SECRET=
# Optional MySQL backend (JSON is the standalone default).
FTW_DB_HOST=127.0.0.1
FTW_DB_PORT=3306
FTW_DB_USER=ftw
FTW_DB_PASSWORD=
FTW_DB_NAME=ftw
